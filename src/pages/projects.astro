---
import BaseLayoutAstroComponent from "../layouts/BaseLayout.astro"
import PageLayoutAstroComponent from "../components/PageLayout.astro";
import NavAstroComponent from "../components/Nav.astro";

const baseUrl = import.meta.env.BASE_URL;
---
<BaseLayoutAstroComponent
  title="Personal Information"
  description="Education and professional background for Bunchhean Chhoung"
>
  <PageLayoutAstroComponent>
    <!-- Main content -->
    <p class="m-0 text-[11px] tracking-wide text-neutral-400">
      <a
        href={baseUrl}
        class="text-neutral-400 underline transition-colors hover:text-neutral-700"
      >Back</a>
    </p>
    <!-- Header -->
    <h1 class="mt-3 mb-0 text-[32px] font-normal [font-family:'EB_Garamond_Variable',Georgia,serif] sm:text-[40px]">Projects.</h1>
    <p class="mt-2 text-sm text-neutral-400">Things I've built.  </p>

    <!-- body -->
    <div class="mt-8 flex flex-col gap-8 text-sm leading-relaxed">
      <p>Page in progressing...</p>
    </div>

    <!-- Footer slot -->
    <NavAstroComponent slot="footer" />
  </PageLayoutAstroComponent>
</BaseLayoutAstroComponent>