---
import BaseLayoutAstroComponent from "../layouts/BaseLayout.astro"
import PageLayoutAstroComponent from "../components/PageLayout.astro";
import CardAstroComponent from "../components/ui/Card.astro";
const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---
<BaseLayoutAstroComponent
  title="Projects | Chhean"
  description="Education and professional background for Bunchhean Chhoung"
>
  <PageLayoutAstroComponent>
    <!-- Main content -->
    <p class="m-0 mb-12 text-muted text-[12px] tracking-wide ">
      <a
        href={baseUrl}
        class="text-neutral-400  underline transition-colors hover:text-neutral-700"
      >Back</a>
    </p>
    <!-- Header -->
    <h1 class="mt-3 mb-0 text-sm font-medium ">Projects.</h1>
    <p class="mt-2 text-sm text-muted">Explore some of the projects and tools I've built.</p>

    <!-- body -->
    <div class="mt-8 mb-8 flex flex-col gap-8 text-sm leading-relaxed">
      <CardAstroComponent/>
    </div>

    <!-- Footer -->
    <footer class="flex items-center justify-between border-muted/30  text-primary text-xs ">
      <span class="inline-flex mb-18 items-center gap-2">
        © {year} chhean. all rights reserved.
      </span>
    </footer>
  </PageLayoutAstroComponent>
</BaseLayoutAstroComponent>
