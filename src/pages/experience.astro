---
import BaseLayoutAstroComponent from '../layouts/BaseLayout.astro';
import PageLayoutAstroComponent from '../components/PageLayout.astro';
import { Image } from 'astro:assets';
import NavAstroComponent from '../components/Nav.astro';
import AchievementAstroComponent from '../components/Achievement.astro';
import EducatioinAstroComponent from '../components/Education.astro';
import SkillsAstroComponent from '../components/Skills.astro';
import ExperienceAstroComponen from '../components/Experience.astro';

const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayoutAstroComponent
  title="Journey | Chhoung Bunchhean"
  description="Education and professional background for Bunchhean Chhoung"
>
  <PageLayoutAstroComponent>
    <main class="flex min-h-screen flex-col gap-14 sm:gap-14">
    <!-- Header -->
     <section>
      <p class="mb-3 font-medium text-sm">Professional Journey.</p>
      <p class="text-sm text-muted">My education, work experience, technical skills, certifications, and notable achievements. </p>
     </section>
    <!-- <p class=" text-sm text-muted">My education, work experience, technical skills, certifications, and notable achievements. </p> -->

    <!-- body -->
    <div class="flex flex-col gap-12 text-sm leading-relaxed">
      <!--<ExperienceAstroComponent />-->
      <EducatioinAstroComponent/>
      <SkillsAstroComponent/>
      <!--<AchievementAstroComponent/>-->
    </div>

    <!-- Footer -->
    <footer class="pt-2 text-primary text-xs">
      <span class="inline-flex items-center gap-2">
        © {year} Chhean. All rights reserved.
      </span>
    </footer>
  </main>
  </PageLayoutAstroComponent>
</BaseLayoutAstroComponent>

<script>
  const initializeThemeToggle = () => {
    const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');

    if (themeToggle) {
      const root = document.documentElement;
      const getTheme = () => root.dataset.theme ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

      const updateThemeToggle = () => {
        const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';
        themeToggle.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
        themeToggle.setAttribute('title', `Switch to ${nextTheme} mode`);
      };

      themeToggle.addEventListener('click', () => {
        const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = nextTheme;
        localStorage.setItem('theme', nextTheme);
        updateThemeToggle();
      });

      updateThemeToggle();
    }
  };

  document.addEventListener('astro:page-load', initializeThemeToggle);
  initializeThemeToggle();
</script>
