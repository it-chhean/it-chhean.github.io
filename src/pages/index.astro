---
import BaseLayoutAstroComponent from '../layouts/BaseLayout.astro';
import LinkColumn from '../components/ui/LinkColumn.astro';
import PageLayoutAstroComponent from '../components/PageLayout.astro';
import { Image } from 'astro:assets';
import NavAstroComponent from '../components/Nav.astro';
import CardAstroComponent, { Card } from '../components/ui/Card.astro';

const building = [
  {
    title: 'Unemployee',
    href: '/',
    external: false,
    description: 'Seeking for job portonity.',
  },
];

const projects = [
  {
    title: 'www.configly.site',
    href: 'https://configly.site',
    external: true,
    description: 'Convert configuraition file instantly.',
  }
];

const writing = [
  {
    title: 'All writing',
    href: '/writing',
    external: false,
    description: 'Infrequent thoughts on design and code.',
  }
];

const columns = [
  { label: 'Work Experience', items: building },
  { label: 'Projects', items: projects },
  { label: 'writing', items: writing },
];

const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayoutAstroComponent
  title="Chhoung Bunchhean"
  description="I'm a software developer. I focus on writing clean, maintainable code and building applications that deliver meaningful experiences. Every project is an opportunity to learn, improve, and create something valuable."
>
  <PageLayoutAstroComponent>
    <main class="flex min-h-screen flex-col gap-8 sm:gap-8">
      <!-- Intro -->
      <section>
        <div class="flex flex-col gap-0 sm:gap-8 sm:flex-row sm:items-center justify-between sm:justify-between">
          <!-- profile section -->
          <div>
            <button
              id="theme-toggle"
              type="button"
              aria-label="Switch to dark mode"
              title="Switch theme"
              class="block cursor-pointer mt-2 sm:mt-11 md:mt-11 appearance-none rounded-full border-0 bg-transparent p-0"
            >
              <span class="relative block h-[60px] w-[60px]">
                <Image
                  src={`${baseUrl}icon-dark.svg`}
                  alt="Profile picture"
                  width={230}
                  height={230}
                  format="webp"
                  loading="eager"
                  class="theme-image-light absolute inset-0 h-[40px] w-[40px]  object-cover"
                />
                <Image
                  src={`${baseUrl}icon-white.svg`}
                  alt=""
                  width={230}
                  height={230}
                  format="webp"
                  loading="eager"
                  class="theme-image-dark absolute inset-0 h-[40px] w-[40px] object-cover"
                />
              </span>
            </button>
          </div>
          <div class="sm:mt-2">
            <NavAstroComponent />
          </div>
        </div>
      </section>

      <!-- Now -->
      <section class="">
        <h1 class="text-sm mb-3 font-normal text-fg">
          Hey, I'm Chhean !
        </h1>
        <!--<p class="max-w-xl mb-3 text-muted text-sm ">
          I'm a <span class="text-fg">" Full-Stack Developer  "</span> that's developing skill through doing, exploring passion and
          interests, imbuing quality. Mindful that
          <em>everything around me is someone&rsquo;s life work.</em>
        </p>-->

        <p class="max-w-xl mb-3 text-muted text-sm ">
        I'm a <span class="text-fg">" full-stack developer "</span> generalist who cares deeply about system design, infrastructure, maintainance, scalable and  system.
        </p>

        <p class="text-muted text-sm ">
        I've built interfaces, research, document, and realtime infrastructure, AI agents, developer tools, and tinker with more on the side.
        </p>

        <!--<p class="text-muted text-sm ">
          All I want to do is build a useful software. Optimization, performance&mdash;the web/mobile is an endless medium of
          opportunity and creativity of which I&rsquo;ve only scratched the
          surface.
        </p>-->
      </section>

      <!-- Columns -->
      <section class="grid grid-cols-3 gap-8 max-sm:grid-cols-1 max-sm:gap-10 ">
        {columns.map((col) => <LinkColumn label={col.label} items={col.items} />)}
      </section> 

      <!-- contact -->
      <section class="">
        <h2 class="text-sm mb-2 font-medium text-fg">
          Get in touch
        </h2>
        <p class="text-sm">
          <span class="text-muted">Open to any opportunities: freelance, part-time, contract, or full-time.</span>
          <span class="text-muted"> You can reach me at</span>
          <span class="m-0 tracking-wide">
            <a
              href="https://www.github.com/it-chhean"
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-white/35"
              title="GitHub"
            >
              github
            </a>,
          </span>
          <span class="m-0 tracking-wide">
            <a
              href="mailto:bchhean8@gmail.com"
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-white/35"
              title="Email"
            >
              email
            </a>
          </span>
          <span class="text-muted">and</span>
          <span class="m-0 tracking-wide">
            <a
              href="https://www.linkedin.com/in/chhoung-bunchhean/"
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-white/35"
              title="LinkedIn"
            >
            linkedin
            </a>.
          </span>
        </p>
      </section>

    <!-- Footer -->
    <footer class="pt-2 text-primary text-xs">
      <span class="inline-flex items-center gap-2">
        © {year} Chhean. All rights reserved.
      </span>
    </footer>
  </main>
  </PageLayoutAstroComponent>
</BaseLayoutAstroComponent>

<script>
  const initializeThemeToggle = () => {
    const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');

    if (themeToggle) {
      const root = document.documentElement;
      const getTheme = () => root.dataset.theme ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

      const updateThemeToggle = () => {
        const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';
        themeToggle.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
        themeToggle.setAttribute('title', `Switch to ${nextTheme} mode`);
      };

      themeToggle.addEventListener('click', () => {
        const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = nextTheme;
        localStorage.setItem('theme', nextTheme);
        updateThemeToggle();
      });

      updateThemeToggle();
    }
  };

  document.addEventListener('astro:page-load', initializeThemeToggle);
  initializeThemeToggle();
</script>
