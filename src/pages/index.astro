              title="GitHub"
            >
              github
            </a>,
          </span>
          <span class="m-0 tracking-wide">
            <a
              href="mailto:bchhean8@gmail.com"
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-white/35"
              title="Email"
            >
              email
            </a>
