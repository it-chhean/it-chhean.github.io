---
import BaseLayoutAstroComponent from '../layouts/BaseLayout.astro';
import LinkColumn from '../components/ui/LinkColumn.astro';
import NavAstroComponent from '../components/Nav.astro';
import PageLayoutAstroComponent from '../components/PageLayout.astro';
import { Image } from 'astro:assets';
import HeroBackgroundAstroComponent from '../components/HeroBackground.astro';

const building = [
  {
    title: 'Professor Assistant',
    href: '/',
    external: false,
    description: 'Implementing projects and Networking.',
  },
];

const projects = [
  {
    title: 'www.configly.site',
    href: 'https://configly.site',
    external: true,
    description: 'Convert configuraition file instantly.',
  },
  {
    title: 'Mhob',
    href: 'https://mhob.vercel.app',
    external: true,
    description: 'Khmer foods tranditional recipe',
  },
];

const writing = [
  {
    title: 'React Hook Getter Pattern',
    href: '/writing/hook-getter',
    external: false,
    description: 'Simple, efficient React state hook in 50 lines.',
  },
  {
    title: 'Redesign 2021',
    href: '/writing/redesign-2021',
    external: false,
    description: 'Return to simplicity.',
  },
  {
    title: 'All writing',
    href: '/writing',
    external: false,
    description: 'Infrequent thoughts on design and code.',
  },
];

const columns = [
  { label: 'Work Experience', items: building },
  { label: 'Projects', items: projects },
  { label: 'writing', items: writing },
];

const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayoutAstroComponent
  title="Chhong Bunchhean"
  description="I'm a software developer. I focus on writing clean, maintainable code and building applications that deliver meaningful experiences. Every project is an opportunity to learn, improve, and create something valuable. "
>
<PageLayoutAstroComponent>
  <main class="h-screen">
    <!-- Intro -->
    <section class="mb-14">
    <div class="flex flex-col gap-4 mb-8 sm:flex-row sm:justify-between ">
      <!-- profile section -->
      <div class="flex min-w-0 flex-row items-center gap-4">
        <Image
          src={`${baseUrl}profile.png`}
          alt=""
          width={210}
          height={210}
          format='webp'
          loading={'eager'}
          class="h-[60px] w-[60px] shrink-0 rounded-md"
        />
        <div class="mt-[-2px]">
          <h1 class="text-lg text-fg">
            Bunchhean Chhoung
          </h1>
          <p class="text-xs text-muted font-mono">
          <span class="text-green-500">@it-bunchhean</span>:<span class="text-blue-700">~</span>$ whoami
          </p>
          <p class="text-xs text-fg">
              Junior Software Developer
          </p>
        </div>
      </div>
        <div class="mt">
           <NavAstroComponent/> 
        </div>
    </div>
    </section>

    <!-- Now -->
    <section class="mb-16">
      <h2 class="mb-4 text-sm font-medium text-fg">
        Now
      </h2>

      <p class="text-muted text-sm mb-[18px]">
        Developing skill through doing, exploring passion and
        interests, imbuing quality. Mindful that
        <em>everything around me is someone&rsquo;s life work.</em>
      </p>

      <p class="text-muted text-sm mb-[18px]">
      All I want to do is build websites & mobile applications. Optimization, performance&mdash;the web/mobile is an endless medium of
        opportunity and creativity of which I&rsquo;ve only scratched the
        surface.
      </p>
    </section>
    <!-- Columns -->
    <section class="grid grid-cols-3 gap-8 my-[72px] max-sm:grid-cols-1 max-sm:gap-10 max-sm:my-14">
      {columns.map((col) => <LinkColumn label={col.label} items={col.items} />)}
    </section>

    <!-- contact -->
    <section class="mb-16">
      <h2 class="mb-4 text-sm font-medium text-fg">
          Contact
      </h2>
      <p class="text-sm ">
      <span class="text-muted">You can reach me at</span>
        <span class="m-0 tracking-wide ">
            <a
              href="mailto:bchhean8@gmail.com"
              target="_blank"
              rel="noopener noreferrer"
              class="underline  decoration-white/35 "
              title="Email"
            >
            email
            </a>
        </span>
      <span class="text-muted">or</span>
          <span class="m-0 tracking-wide">
                <a
                  href="https://www.linkedin.com/in/chhoung-bunchhean/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-white/35"
                  title="LinkedIn"
                >
                @in/chhoung-bunchhean 
                </a>.
          </span>
      </p>
    </section>

    <!-- Footer -->
    <footer class="flex items-center justify-between border-muted/30 pt-6 text-muted-2 text-[13px] ">
      <span class="inline-flex items-center gap-2">
        © {year} all rights reserved.
      </span>
    </footer>
  </main>
</PageLayoutAstroComponent>
</BaseLayoutAstroComponent>
