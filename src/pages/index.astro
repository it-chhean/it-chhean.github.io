import NavAstroComponent from '../components/Nav.astro';
import ExperienceAstroComponent from '../components/Experience.astro';
import EducationAstroComponent from '../components/Education.astro';
import CardAstroComponent, { Card } from '../components/ui/Card.astro';

const building = [
  {
    title: 'Unemployee',
    href: '/',
    external: false,
    description: 'Seeking for job portonity.',
  },
