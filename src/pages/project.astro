---
import BaseLayoutAstroComponent from '../layouts/BaseLayout.astro';
import LinkColumn from '../components/ui/LinkColumn.astro';
import PageLayoutAstroComponent from '../components/PageLayout.astro';
import { Image } from 'astro:assets';
import NavAstroComponent from '../components/Nav.astro';
import CardAstroComponent, { Card } from '../components/ui/Card.astro';

const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayoutAstroComponent
  title="Projects | Chhoung Bunchhean"
  description="I'm a software developer. I focus on writing clean, maintainable code and building applications that deliver meaningful experiences. Every project is an opportunity to learn, improve, and create something valuable."
>
  <PageLayoutAstroComponent>
    <main class="flex min-h-screen flex-col gap-14 sm:gap-14">

    <!-- Header -->
     <section>
      <p class="font-medium mb-3 text-sm">Projects</p>
      <p class="text-sm text-muted">Base on projects, tools and things I've built.</p>
     </section>

      <!-- Card projects -->
      <CardAstroComponent></CardAstroComponent>

    <!-- Footer -->
    <footer class="pt-2 text-primary text-xs">
      <span class="inline-flex items-center gap-2">
        © {year} Chhean. All rights reserved.
      </span>
    </footer>
  </main>
  </PageLayoutAstroComponent>
</BaseLayoutAstroComponent>

<script>
  const initializeThemeToggle = () => {
    const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');

    if (themeToggle) {
      const root = document.documentElement;
      const getTheme = () => root.dataset.theme ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

      const updateThemeToggle = () => {
        const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';
        themeToggle.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
        themeToggle.setAttribute('title', `Switch to ${nextTheme} mode`);
      };

      themeToggle.addEventListener('click', () => {
        const nextTheme = getTheme() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = nextTheme;
        localStorage.setItem('theme', nextTheme);
        updateThemeToggle();
      });

      updateThemeToggle();
    }
  };

  document.addEventListener('astro:page-load', initializeThemeToggle);
  initializeThemeToggle();
</script>
