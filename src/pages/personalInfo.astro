---
import BaseLayoutAstroComponent from '../layouts/BaseLayout.astro';
import PageLayoutAstroComponent from '../components/PageLayout.astro';
import EducatioinAstroComponent from '../components/Educatioin.astro';
import SkillsAstroComponent from '../components/Skills.astro';
import AchievementAstroComponent from '../components/Achievement.astro';

const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayoutAstroComponent
  title="Professional Journey."
  description="Education and professional background for Bunchhean Chhoung"
>
  <PageLayoutAstroComponent>
    <!-- Main content -->
    <p class="m-0 text-[12px] text-muted tracking-wide mb-12 ">
      <a
        href={baseUrl}
        class="text-muted underline transition-colors hover:text-neutral-700"
      >Back</a>
    </p>
    <!-- Header -->
    <h1 class="mt-3 mb-0 font-medium text-sm">Professional Journey.</h1>
    <p class="mt-2 text-sm text-muted">My education, work experience, technical skills, certifications, and notable achievements. </p>

    <!-- body -->
    <div class="mt-12 mb-8 flex flex-col gap-8 text-sm leading-relaxed">
      <section class="mt-2 mb-8">
        <h2 class="m-0 text-sm font-medium text-fg">Work Experiences</h2>
        <p class="mt-4 text-muted">Recently seeking jobs opportunities.</p>
      </section>
       <!-- <ExperienceComponnet/> -->
       <EducatioinAstroComponent/> 
       <SkillsAstroComponent/> 
      <AchievementAstroComponent/>
    </div>

    <!-- Footer -->
    <footer class="flex items-center justify-between border-muted/30 pt-6 text-muted-2 text-[13px] ">
      <span class="inline-flex items-center gap-2">
        © {year} Chhean. All rights reserved.
      </span>
    </footer>
  </PageLayoutAstroComponent>
</BaseLayoutAstroComponent>
