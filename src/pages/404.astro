---
import Layout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---
<Layout  title="Page Not Found" description="Page not found">
   <div class="flex flex-col h-screen gap-4 items-center justify-center ">
         <h1 class="text-base">404 - Page Not Found</h1>
         <p class="text-sm">Sorry, we can not find the page you are looking for.</p>
         <a href={baseUrl} class="underline text-sm">Return Home</a>
  </div>
</Layout>