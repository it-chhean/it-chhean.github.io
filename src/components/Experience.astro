---
import { ChevronRight } from '@lucide/astro';

export interface WorkExperienceItem {
  role: string;
  team?: string;
  company: string;
  companyHref?: string;
  location?: string;
  startDate: string;
  endDate: string;
  summary: string;
  responsibilities: string[];
  tags: string[];
}

interface Props {
  items?: WorkExperienceItem[];
  heading?: string;
}

const DEFAULT_ITEMS: WorkExperienceItem[] = [
  {
    role: "Intern Full-Stack Developer ",
    team: "Innovation",
    company: "WING Bank (Cambodia) Plc",
    companyHref: "/",
    location: "Phnom Penh",
    startDate: "Jun 2026",
    endDate: "Present",
    summary: "Intership engineering in the Innovation Department, working on research, prototyping, and production development  of AI-driven system within a regulated banking enviroment.",
    responsibilities: [
      "Design and develop AI-enabled internal platforms supporting automation and decision-making workflows in a regulated financial context",
      "Lead hands-on R&D initiatives involving LLM integration, system experimentation, and feasibility assessment for production adoption",
      "Build and maintain full-stack systems (web, backend, APIs) with a focus on scalability, security, and maintainability",
    ],
    tags: ["Next.js", "Node.js", "Spring Boot"],
  },
];

const { items = DEFAULT_ITEMS, heading = "Work Experience" } = Astro.props;
---

<section class="mb-8">
  <h2 class="m-0 text-sm font-medium text-fg">{heading}</h2>

  <ol class="mt-4 ">
    {
      items.map((item, index) => (
        <li class="relative list-none ">
          <div class={index !== items.length - 1 ? "pb-8" : ""}>
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
              <div class="min-w-0">
                <h3 class="m-0 text-sm font-normal text-white">
                  {item.role}
                  {item.team ? ` - ${item.team}` : ""}
                </h3>

                <p class="mt-1 text-xs leading-relaxed">
                  {item.companyHref ? (
                    <a
                      href={item.companyHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-white underline decoration-white/35 underline-offset-[3px] transition-[text-decoration-color] duration-150 hover:decoration-current"
                    >
                      {item.company}
                    </a>
                  ) : (
                    <span class="text-white">{item.company}</span>
                  )}
                  {item.location ? (
                    <span class="text-muted"> • {item.location}</span>
                  ) : null}
                </p>
              </div>
              <div class="sm:mt-[-23px]">
                <p class="text-[12px] text-muted whitespace-nowrap">
                  {item.startDate} - {item.endDate}
                </p>
              </div>
            </div>

            <p class="mt-2 text-[14px] leading-[1.5] text-muted">
              {item.summary}
            </p>

            {item.responsibilities.length > 0 && (
              <details class="responsibilities group mt-2 overflow-hidden rounded-md">
                <summary class="flex w-fit cursor-pointer list-none items-center gap-1 border-b border-dashed border-white/35 text-[13px] text-muted select-none transition-colors duration-200 hover:text-fg">
                  <ChevronRight
                    size={16}
                    class="chevron shrink-0 transition-transform duration-300 ease-out group-open:rotate-0"
                  />
                  View responsibilities
                </summary>

                <div class="grid transition-[grid-template-rows,opacity] duration-300 ease-out grid-rows-[0fr] group-open:grid-rows-[1fr]">
                  <div class="overflow-hidden">
                    <ul class="mt-2 list-disc space-y-1.5 pl-5">
                      {item.responsibilities.map((r) => (
                        <li class="text-[14px] leading-[1.5] text-muted">{r}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </details>
            )}

            {item.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class="rounded-md border border-white/10 bg-white/5 px-2 py-1 text-[12px] text-muted">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>