---
const linkClass = 'text-muted underline  decoration-white/35 underline-offset-[3px] transition-colors hover:text-neutral-700';
const baseUrl = import.meta.env.BASE_URL;
---

<nav class="mx-auto flex w-full flex-wrap items-center justify-between gap-x-4 gap-y-2 text-xs mt-4 text-fg sm:justify-start sm:gap-4">
  <a href={`https://www.github.com/it-chhean`} class={linkClass}>GitHub</a>
  <span aria-hidden="true" class=" h-3 w-px bg-white/20 sm:inline-block "></span>
  <a href={`${baseUrl}personalInfo`} class={linkClass}>Experiences</a>
  <span aria-hidden="true" class=" h-3 w-px bg-white/20 sm:inline-block "></span>
  <a href={`${baseUrl}projects`} class={linkClass}>Projects</a>
  <span aria-hidden="true" class=" h-3 w-px bg-white/20 sm:inline-block "></span>
  <a href={`${baseUrl}blog`} class={linkClass}>Blogs</a>
</nav>
