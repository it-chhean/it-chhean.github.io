---
const linkClass = 'text-muted underline  decoration-white/35 underline-offset-[3px] transition-colors hover:text-neutral-700';
const baseUrl = import.meta.env.BASE_URL;
---

<nav class="mx-auto flex w-full flex-wrap items-center justify-between gap-x-2 gap-y-2 text-xs mt-4 text-fg sm:justify-start sm:gap-4">
  <a href={`${baseUrl}`} class={linkClass}>Home</a>
  <span aria-hidden="true" class=" h-3 w-px bg-white/20 sm:inline-block "></span>
  <a href={`${baseUrl}experience`} class={linkClass}>Experiences</a>
  <span aria-hidden="true" class=" h-3 w-px bg-white/20 sm:inline-block "></span>
  <a href={`${baseUrl}project`} class={linkClass}>Projects</a>
  <span aria-hidden="true" class=" h-3 w-px bg-white/20 sm:inline-block "></span>
  <a href={`${baseUrl}sharing`} class={linkClass}>Blog</a>
</nav>
