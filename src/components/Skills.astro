---
interface SkillGroup {
  label: string;
  skills: Skill[];
}

interface Skill {
  name: string;
  icon?: string;
}

interface Props {
  heading?: string;
  groups?: SkillGroup[];
}

const DEFAULT_GROUPS: SkillGroup[] = [
  {
    label: "Frontend:",
    skills: [
      { name: " React,", icon: "" },
      { name: " Next.js,", icon: "" },
      { name: " Vue.js,", icon: "" },
      { name: " TypeScript,", icon: "" },
      { name: " Tailwind CSS.", icon: "" },
    ],
  },
  {
    label: "Backend:",
    skills: [
      { name: " Spring Boot,", icon: "" },
      { name: " Express.js,", icon: "" },
      { name: " Node.js.", icon: "" },
    ],
  },
  {
    label: "Mobile App Developments:",
    skills: [
      { name: " Dart, ", icon: "" },
      { name: " Flutter.", icon: "" },
    ],
  },
  {
    label: "Database & Tools: ",
    skills: [
      { name: " PostgreSQL, ", icon: "" },
      { name: " MySQL, ", icon: "" },
      { name: " Git, ", icon: "" },
      { name: " Docker, ", icon: "" },
      { name: " Vim.", icon: ""}
    ],
  },
];

const { heading = "Tech Stack", groups = DEFAULT_GROUPS } = Astro.props as Props;
---

<section class="">
  <h2 class="mb-2 text-sm font-medium text-fg">{heading}</h2>
  <div class="flex flex-col ">
    {
      groups.map((group) => (
        <div>
            <ul class="m-0 flex flex-wrap gap-1 md:gap-3 list-none p-0">
          <h3 class="text-sm text-muted">
            {group.label}
          </h3>
            {group.skills.map((skill) => (
              <li>
                <span class="">
                    {skill.icon && <i class={`${skill.icon} colored text-base`} aria-hidden="true"></i>
                    }
                  {skill.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
