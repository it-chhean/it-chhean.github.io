---
interface SkillGroup {
  label: string;
  skills: Skill[];
}

interface Skill {
  name: string;
  icon?: string;
}

interface Props {
  heading?: string;
  groups?: SkillGroup[];
}

const DEFAULT_GROUPS: SkillGroup[] = [
  {
    label: "Frontend:",
    skills: [
      { name: "React", icon: "devicon-react-plain" },
      { name: "Next.js", icon: "devicon-nextjs-plain" },
      { name: "Vue.js", icon: "devicon-vuejs-plain" },
      { name: "TypeScript", icon: "devicon-typescript-plain" },
      { name: "Tailwind CSS", icon: "devicon-tailwindcss-plain" },
    ],
  },
  {
    label: "Backend:",
    skills: [
      { name: "Spring Boot", icon: "devicon-spring-plain" },
      { name: "Express.js", icon: "devicon-express-original" },
      { name: "Node.js", icon: "devicon-nodejs-plain" },
    ],
  },
  {
    label: "Mobile App Developments:",
    skills: [
      { name: "Dart", icon: "devicon-dart-plain" },
      { name: "Flutter", icon: "devicon-flutter-plain" },
    ],
  },
  {
    label: "Database & Tools: ",
    skills: [
      { name: "PostgreSQL", icon: "devicon-postgresql-plain" },
      { name: "MySQL", icon: "devicon-mysql-plain" },
      { name: "Git", icon: "devicon-git-plain" },
      { name: "Docker", icon: "devicon-docker-plain" },
    ],
  },
];

const { heading = "Technical Skills", groups = DEFAULT_GROUPS } = Astro.props as Props;
---

<section class="mb-8">
  <h2 class="m-0 text-sm font-medium text-fg">{heading}</h2>
  <div class="mt-4 flex flex-col gap-3 ">
    {
      groups.map((group) => (
        <div>
          <h3 class="m-0 mb-2 text-sm text-fg/70">
            {group.label}
          </h3>
          <ul class="m-0 flex flex-wrap gap-2 list-none p-0">
            {group.skills.map((skill) => (
              <li>
                <span class="inline-flex items-center gap-1.5 rounded-md border border-fg/10 bg-fg/5 px-2 py-1.5 text-xs text-fg/80">
                  {skill.icon && <i class={`${skill.icon} colored text-base`} aria-hidden="true"></i>}
                  {skill.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>