---
/**
 * LinkRow component
 */
import LinkItem from './LinkItem.astro';

export interface LinkEntry {
  title: string;
  href: string;
  external: boolean;
  description: string;
}

export interface Props {
  label: string;
  items: LinkEntry[];
}

const { label, items } = Astro.props;
---

<div>
  <h2 class="text-sm text-fg/80 mb-2"><em>{label}</em></h2>
  <ul class="list-none m-0 p-0 flex flex-cols gap-6">
    {items.map((item) => <LinkItem {...item} />)}
  </ul>
</div>
