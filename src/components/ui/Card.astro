---
export interface Project {
  title: string;
  url: string;
  description: string;
  tags: string[];
  logo?: string; 
  logoAlt?: string;
  year: string; 
}

export const projects: Project[] = [
  {
    title: "www.configly.site",
    url: "https://www.configly.site",
    description:
      "Fast, reliable configuration file conversion. No uploads, no servers, your data is processed locally in your browser.",
    tags: ["Next.js", "Typescript", "Bun"],
    logo: "/image/project-showcase.png",
    logoAlt: "",
    year: "Ongoing",
  }
];

const groups = projects.reduce<Record<string, Project[]>>((acc, project) => {
  (acc[project.year] ??= []).push(project);
  return acc;
}, {});

const orderedYears = Object.keys(groups).sort((a, b) => {
  if (a === "Ongoing") return -1;
  if (b === "Ongoing") return 1;
  return Number(b) - Number(a);
});
---

<section>
  <div class="">
    {orderedYears.map((year) => (
      // <div class="grid grid-cols-1 gap-y-8 sm:grid-cols-[72px_1fr] sm:gap-x-4 md:grid-cols-[96px_1fr] md:gap-x-6 lg:gap-x-8">
      <div>
        <p class="text-xs sm:text-sm text-muted mb-2 font-normal">{year}</p>
        <div class="space-y-6 sm:space-y-8 md:space-y-10">
          {groups[year].map((project) => (
            <article class="flex flex-col sm:flex-row gap-3 sm:gap-4 md:gap-5">
              <div class="space-y-2 w-full ">
              {project.logo && (
                <img
                  src={project.logo}
                  alt={project.logoAlt ?? `${project.title} logo`}
                  class="h-auto w-full shrink-0 rounded-md object-cover"
                  loading="lazy"
                />
              )}
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex underline decoration-white/35 items-center gap-1 mt-2 font-medium text-white underline-offset-2 text-sm sm:text-base"
                >
                  {project.title}
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0">
                     <path d="M10.9639 8.92676L10.957 3.59473C10.957 3.42155 10.9023 3.28027 10.793 3.1709C10.6882 3.05697 10.5446 3 10.3623 3H5.03027C4.8571 3 4.7181 3.05697 4.61328 3.1709C4.50846 3.28027 4.45605 3.41016 4.45605 3.56055C4.45605 3.70638 4.51074 3.83398 4.62012 3.94336C4.73405 4.05273 4.86393 4.10742 5.00977 4.10742H6.58887L9.2959 4.01172L8.26367 4.89355L3.1709 10C3.05697 10.1094 3 10.237 3 10.3828C3 10.5332 3.05697 10.6676 3.1709 10.7861C3.28939 10.9046 3.42383 10.9639 3.57422 10.9639C3.72461 10.9639 3.85449 10.9092 3.96387 10.7998L9.06348 5.69336L9.95898 4.66113L9.84277 7.34766V8.9541C9.84277 9.09994 9.89746 9.22982 10.0068 9.34375C10.1208 9.45768 10.2529 9.51465 10.4033 9.51465C10.5492 9.51465 10.679 9.45996 10.793 9.35059C10.9069 9.23665 10.9639 9.09538 10.9639 8.92676Z" fill="white"/>
                  </svg>
                </a>

                <p class="max-w-xl text-sm text-muted ">
                  {project.description}
                </p>

                <p class="text-xs text-muted-2">
                  {project.tags.join(" • ")}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
